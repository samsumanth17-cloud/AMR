# Industrial AMR Fleet Manager & Digital Twin Configuration

# Google Gemini API Key for semantic fleet reasoning & deadlock analysis
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (gemini-2.5-flash, gemini-1.5-flash, or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Network Hosting Configuration
AMR_HOST=127.0.0.1
AMR_PORT=5000
AMR_DEBUG=False
